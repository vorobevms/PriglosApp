{
  "name": "priglos-app",
  "version": "1.6.0",
  "description": "Офлайн создание приглашений",
  "author": "PriglosApp",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win portable --x64",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "build:mac": "node scripts/build-mac.cjs arm64",
    "build:mac:x64": "node scripts/build-mac.cjs x64",
    "prepare:mac": "node scripts/prepare-mac.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "ru.priglos.app",
    "productName": "Приглашения",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/template-config.js",
      "assets/portal-template.png",
      "assets/balloons-template.png",
      "assets/designs/*_фон.png",
      "assets/fonts/**/*",
      "assets/balloon.png",
      "assets/balloon.ico",
      "package.json"
    ],
    "portable": {
      "artifactName": "Конструктор приглашений.exe"
    },
    "win": {
      "target": "portable",
      "icon": "assets/balloon.ico"
    }
  }
}
